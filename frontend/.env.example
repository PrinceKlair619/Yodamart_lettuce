# frontend/.env.example
#
# No environment variables are required.
#
# The LettuceMarket address is set at runtime by the browser — either
# by deploying from the UI or by pasting an existing address.
# It is stored in localStorage and does not need to be configured here.
#
# Optional: if you want to pre-set a known LettuceMarket address so
# users skip the deploy step, set this and rebuild:
#
# VITE_LETTUCE_MARKET_ADDRESS=0xYourDeployedLettuceMarketAddress
#
# YODA token address (already correct — only change if using a different token)
# VITE_YODA_TOKEN_ADDRESS=0xbd27d0b7F9fedb5A2A2C3ceF5dC9c70f3CF64Af2
